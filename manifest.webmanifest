{
 "name": "دفترچه شخصی بابک",
 "short_name": "دفترچه بابک",
 "description": "Notes, handwriting, PDF — synced through your own Google Drive",
 "lang": "fa",
 "dir": "rtl",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "orientation": "any",
 "background_color": "#f4efe6",
 "theme_color": "#d97757",
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png"
  },
  {
   "src": "icon-maskable.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ],
 "share_target": {
  "action": "./share-target",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "title": "title",
   "text": "text",
   "url": "url",
   "files": [
    {
     "name": "files",
     "accept": [
      "application/pdf",
      ".pdf",
      "image/*",
      ".jpg",
      ".jpeg",
      ".png",
      ".webp",
      ".heic",
      "text/plain",
      ".txt",
      ".md",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      ".docx",
      "application/zip",
      ".zip"
     ]
    }
   ]
  }
 },
 "file_handlers": [
  {
   "action": "./",
   "accept": {
    "application/pdf": [
     ".pdf"
    ],
    "image/*": [
     ".jpg",
     ".jpeg",
     ".png",
     ".webp",
     ".heic"
    ],
    "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [
     ".docx"
    ],
    "text/plain": [
     ".txt",
     ".md"
    ]
   }
  }
 ],
 "launch_handler": {
  "client_mode": "focus-existing"
 }
}